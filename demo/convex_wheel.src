$BASE = BASE_DATA[3]
$TOOL = TOOL_DATA[2]
PTP {A4 90, A5 -90}

; ### A1 ###
PTP A1[1]
SPLINE WITH $VEL= {CP 0.007, ORI1 0.005, ORI2 0.005}
  SLIN A1[2] WITH $VEL.CP = 0.01
  SPL A1[3]
  SPL A1[4]
  SPL A1[5]
  SPL A1[6]
  SPL A1[7]
  SPL A1[8]
  SPL A1[9]
  SPL A1[10]
  SPL A1[11]
  SPL A1[12]
  SPL A1[13]
  SPL A1[14]
  SPL A1[15]
  SPL A1[16]
  SPL A1[17] WITH $VEL.CP = 0.01
ENDSPLINE

$VEL.CP = 0.07
LIN_REL {Z 400}