DEF convex_wheel()
INI

PTP HOME Vel=100% DEFAULT

$BASE = BASE_DATA[3]
$TOOL = TOOL_DATA[2]

PTP {A1 0, A2 -90, A3 90, A4 0, A5 0, A6 0}

; ### A1 ###
PTP A1[1]
SPLINE WITH $VEL= {CP 0.007, ORI1 0.005, ORI2 0.005}
  SPL A1[2] WITH $VEL.CP = 0.01
  SPL A1[3]
  SPL A1[4]
  SPL A1[5]
  SPL A1[6]
  SPL A1[7]
  SPL A1[8]
  SPL A1[9]
  SPL A1[10]
  SPL A1[11]
  SPL A1[12]
  SPL A1[13]
  SPL A1[14]
  SPL A1[15]
  SPL A1[16]
  SPL A1[17] WITH $VEL.CP = 0.01
ENDSPLINE

$VEL.CP = 0.01
LIN_REL {Z 10}

; ### A2 ###
PTP A2[1]
SPLINE WITH $VEL= {CP 0.007, ORI1 0.005, ORI2 0.005}
  SPL A2[2] WITH $VEL.CP = 0.01
  SPL A2[3]
  SPL A2[4]
  SPL A2[5]
  SPL A2[6]
  SPL A2[7]
  SPL A2[8]
  SPL A2[9]
  SPL A2[10]
  SPL A2[11]
  SPL A2[12]
  SPL A2[13]
  SPL A2[14]
  SPL A2[15]
  SPL A2[16]
  SPL A2[17] WITH $VEL.CP = 0.01
ENDSPLINE

$VEL.CP = 0.01
LIN_REL {Z 10}

; ### A3 ###
PTP A3[1]
SPLINE WITH $VEL= {CP 0.007, ORI1 0.005, ORI2 0.005}
  SPL A3[2] WITH $VEL.CP = 0.01
  SPL A3[3]
  SPL A3[4]
  SPL A3[5]
  SPL A3[6]
  SPL A3[7]
  SPL A3[8]
  SPL A3[9]
  SPL A3[10]
  SPL A3[11]
  SPL A3[12]
  SPL A3[13]
  SPL A3[14]
  SPL A3[15]
  SPL A3[16]
  SPL A3[17] WITH $VEL.CP = 0.01
ENDSPLINE

$VEL.CP = 0.01
LIN_REL {Z 10}