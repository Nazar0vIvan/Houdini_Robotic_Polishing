$BASE = BASE_DATA[6]
$TOOL = TOOL_DATA[2]
LIN_REL {X -200, Y -500}
PTP RE[1]
SPLINE WITH $VEL= {CP 0.007, ORI1 0.005, ORI2 0.005}
  SLIN RE[2]
  SPL RE[3]
  SPL RE[4]
  SPL RE[5]
  SPL RE[6]
  SPL RE[7]
  SPL RE[8]
  SPL RE[9]
  SPL RE[10]
  SPL RE[11]
  SPL RE[12]
  SPL RE[13]
  SPL RE[14]
  SPL RE[15]
  SPL RE[16]
  SPL RE[17]
  SLIN RE[18] WITH $VEL.CP = 0.01
ENDSPLINE

$VEL.CP = 0.07
LIN_REL {Z 400}